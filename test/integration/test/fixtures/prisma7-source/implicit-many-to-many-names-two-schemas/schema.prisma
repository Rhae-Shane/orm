datasource db {
  provider = "postgresql"
  schemas  = ["one", "two"]
}

model A {
  id Int @id
  bs B[] @relation("X")

  @@schema("one")
  @@map("a")
}

model B {
  id Int @id
  as A[] @relation("X")

  @@schema("one")
  @@map("b")
}

model C {
  id Int @id
  ds D[] @relation("X")

  @@schema("two")
  @@map("c")
}

model D {
  id Int @id
  cs C[] @relation("X")

  @@schema("two")
  @@map("d")
}
