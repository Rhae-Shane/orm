datasource db {
  provider = "postgresql"
  schemas  = ["public", "shop"]
}

model User {
  id        Int    @id
  favorites Post[] @relation("Favorites")
  followers User[] @relation("Follows")
  following User[] @relation("Follows")

  @@schema("public")
  @@map("user")
}

model Post {
  id   Int    @id
  tags Tag[]
  fans User[] @relation("Favorites")

  @@map("blog_posts")
  @@schema("public")
}

model Tag {
  id    Int    @id
  posts Post[]

  @@schema("public")
  @@map("tag")
}

model Category {
  id       Int       @id
  products Product[]

  @@schema("public")
  @@map("category")
}

model Product {
  id         Int        @id
  categories Category[]

  @@schema("shop")
  @@map("product")
}

model A {
  id   Int @id
  bees B[]
  next A[] @relation("Loop")
  prev A[] @relation("Loop")

  @@schema("public")
  @@map("a")
}

model B {
  id  Int @id
  ays A[]

  @@schema("public")
  @@map("b")
}
