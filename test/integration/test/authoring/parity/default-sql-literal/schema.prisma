// use prisma-8

model T {
  id        String   @id @default(sql`md5(random()::text)`)
  expires   DateTime @default(sql"(now() + '00:03:00'::interval)")
  createdAt DateTime @default(pg.sql`(now() + interval '1 hour')`)
  tags      String[] @default(sql`'{}'::text[]`)
  ident     String   @default(gen_random_uuid())
  escaped   String   @default(sql`E'\n'`)

  @@map("t")
}
